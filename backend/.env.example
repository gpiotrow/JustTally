# Server
PORT=4000
NODE_ENV=development

# Database — Postgres connection string (e.g. a free Neon project: https://neon.tech)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Auth - required, no fallback. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Self-service registration via POST /api/auth/register.
# off  = disabled, admins create accounts via the User Management page (default)
# open = anyone can register as a 'user'
ALLOW_REGISTRATION=off

# CORS - frontend origin.
# Not needed in production on fly.io: the backend serves the built SPA itself,
# so API and app share an origin.
CLIENT_ORIGIN=http://localhost:5173

# Media storage
# MEDIA_DRIVER: 'local' (filesystem / fly volume) — 'r2' follows in a later phase.
MEDIA_DRIVER=local
# Where the local driver writes. Defaults to backend/uploads; on fly.io this
# points at the mounted volume (/data/uploads) so media survives deploys.
# UPLOADS_DIR=/data/uploads

# First admin account (created on first seed)
ADMIN_EMAIL=admin@justtally.local
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Admin
